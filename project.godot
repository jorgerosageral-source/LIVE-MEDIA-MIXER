;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LIVE_MEDIA_MIXER_DJ"
run/main_scene="uid://bi0hb5bbpcbiw"
config/features=PackedStringArray("4.8", "Forward Plus")
